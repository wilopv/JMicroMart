# Copy to .env and set production values
USER_DB_NAME=jmicromart_user
USER_DB_USER=jmicromart_user
USER_DB_PASSWORD=replace-with-strong-password

PRODUCT_DB_NAME=jmicromart_product
PRODUCT_DB_USER=jmicromart_product
PRODUCT_DB_PASSWORD=replace-with-strong-password

ORDER_DB_NAME=jmicromart_order
ORDER_DB_USER=jmicromart_order
ORDER_DB_PASSWORD=replace-with-strong-password

JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRATION_MS=3600000

# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://your-frontend.pages.dev
